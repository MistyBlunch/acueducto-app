# Application
NODE_ENV=development
PORT=3001

# Database (Required)
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=acueducto_dev
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/acueducto_dev

# Security (Required - Generate strong values for production)
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production-must-be-32-chars-minimum
JWT_EXPIRES_IN=7d

# CORS Configuration (Required)
# WEB_ORIGIN is the new primary CORS setting - restrict to your frontend domain
WEB_ORIGIN=http://localhost:3000
# CORS_ORIGIN is kept for backward compatibility
CORS_ORIGIN=http://localhost:3000

# Logging Configuration
LOG_LEVEL=info
# LOG_PRETTY=true enables colored output in development (set to false in production)
LOG_PRETTY=true

# API Documentation
SWAGGER_PATH=api/docs
SWAGGER_TITLE=Acueducto API
SWAGGER_DESCRIPTION=Product search API with intelligent filtering and palindrome discounts
SWAGGER_VERSION=1.0.0

# Rate Limiting
THROTTLE_TTL=60
THROTTLE_LIMIT=10

# Production Security Recommendations:
# - Generate a strong JWT_SECRET (minimum 32 characters)
# - Set WEB_ORIGIN to your production frontend domain (e.g., https://myapp.com)
# - Set LOG_LEVEL to "warn" or "error" in production
# - Set LOG_PRETTY to "false" in production
# - Use DATABASE_URL with connection pooling in production